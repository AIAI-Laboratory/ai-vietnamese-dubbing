# Copy thành ".env" rồi điền — .env không commit lên git (đã trong .gitignore).
# API_KEY BẮT BUỘC phải có giá trị, server từ chối khởi động nếu để trống.
# Sinh 1 key đủ mạnh:
#   python -c "import secrets; print(secrets.token_hex(16))"

PORT=18765
HOST=127.0.0.1

API_KEY=

LOG_LEVEL=INFO

# Voice mặc định; xem danh sách đầy đủ qua GET /api/voices.
KOKORO_VOICE=diem_trinh

# Transcript debug tự xoá sau số ngày này.
DEBUG_RETENTION_DAYS=7

# Job đã xong bị dọn (RAM + file audio trong temp) sau số phút này.
JOB_RETENTION_MIN=60

# Số job chờ/đang chạy tối đa; vượt thì /api/synthesize trả 429.
MAX_PENDING_JOBS=4

# Chặn request body lớn hơn (MB).
MAX_BODY_MB=16
