# Copy thành ".env" rồi điền — .env không commit lên git (đã trong .gitignore).
# API_KEY BẮT BUỘC phải có giá trị, server từ chối khởi động nếu để trống.
# Sinh 1 key đủ mạnh:
#   python -c "import secrets; print(secrets.token_hex(16))"

PORT=18765
HOST=127.0.0.1

API_KEY=

LOG_LEVEL=INFO

# Voice mặc định; xem danh sách đầy đủ qua GET /api/voices.
KOKORO_VOICE=diem_trinh

# Job đã xong bị dọn (RAM + file audio trong temp) sau số phút này.
JOB_RETENTION_MIN=60

# Số job chờ/đang chạy tối đa; vượt thì /api/synthesize trả 429.
MAX_PENDING_JOBS=4

# Chặn request body lớn hơn (MB).
MAX_BODY_MB=16

# Swagger UI (/docs, /redoc, /openapi.json) KHÔNG khoá được bằng API key —
# chúng là route Starlette thuần. Mặc định tắt; chỉ bật khi server nằm trên
# loopback và bạn cần thử tay.
ENABLE_DOCS=0

# Số câu tổng hợp song song. Tăng lên không giúp nếu ít core hơn.
SYNTH_WORKERS=3

# Trần thời gian: một câu tổng hợp, và một lần gọi ffmpeg.
SYNTH_TIMEOUT_SEC=300
FFMPEG_TIMEOUT_SEC=120
