{
  "manifest_version": 3,
  "name": "Local AI Vietnamese Dubbing",
  "version": "0.1.0",
  "description": "Thuyết minh tiếng Việt tự động cho video Coursera. Dịch qua LLM API (base URL tuỳ chọn), tổng hợp giọng nói qua server local trên máy bạn.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/learn/*"],
      "js": [
        "lib/vtt.js",
        "lib/cache.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Local AI Vietnamese Dubbing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html"
}
