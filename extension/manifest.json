{
  "manifest_version": 3,
  "name": "Local AI Vietnamese Dubbing",
  "version": "0.4.0",
  "description": "Thuyết minh tiếng Việt cho bài giảng Coursera và video YouTube. Dịch qua Gemini API, tổng hợp giọng nói ngay trên máy bạn.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coursera.org/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/vtt.js",
        "lib/sites.js",
        "lib/windows.js",
        "lib/cache.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Local AI Vietnamese Dubbing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "author": "Hà Trọng Nguyên (AIAI Lab)",
  "homepage_url": "https://github.com/AIAI-Laboratory/AI-Vietnamese-Dubbing"
}
